generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  name                 String
  phone                String?
  bio                  String?
  avatar               String?
  socialLinks          Json      @default("{}")
  isAdmin              Boolean   @default(false)
  trialEndsAt          DateTime?
  plan                 String?
  planInterval         String?
  planExpiresAt        DateTime?
  clinicoTrialStartedAt DateTime?
  clinicoTrialEndsAt   DateTime?
  hasUsedClinicoTrial  Boolean   @default(false)
  trialAudioSecondsUsed Int      @default(0)
  trialAiNotesUsed     Int       @default(0)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripeHasDiscount    Boolean   @default(false)
  paypalSubscriptionId String?
  welcomeEmailSentAt   DateTime?
  blocked              Boolean   @default(false)
  featureOverrides     Json      @default("{}")
  createdAt            DateTime  @default(now())
  profiles             Profile[]
  professionalBookings Booking[] @relation("ProfessionalBookings")
  clients              Client[]
  activityEvents       ActivityEvent[]
}

model Client {
  id               String    @id @default(cuid())
  userId           String
  name             String
  email            String?
  phone            String?
  notes            String?
  // Campos demográficos para historia clínica
  birthDate        DateTime?
  gender           String?
  maritalStatus    String?
  education        String?
  occupation       String?
  city             String?
  country          String?
  emergencyContact String?
  referralSource   String?
  // Consentimiento expreso (LFPDPPP Art. 9) — ver docs/superpowers/specs/2026-07-02-consentimiento-expreso-design.md
  consentGivenAt   DateTime?
  consentMethod    String?
  consentNotes     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt @default(now())

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicalHistory        ClinicalHistory?
  clinicalHistoryCouple  ClinicalHistoryCouple?
  sessionNotes           SessionNote[]
  audioTranscriptionJobs AudioTranscriptionJob[]

  @@index([userId])
}

model ClinicalHistory {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Paso 2: Motivo de consulta
  chiefComplaint     String?
  symptomDuration    String?
  triggerFactors     String?

  // Paso 3: Historia del problema actual
  currentProblem     String?
  onsetCourse        String?
  currentSymptoms    String?
  previousTreatments String?

  // Paso 4: Antecedentes personales
  medicalHistory     String?
  psychiatricHistory String?
  currentMedication  String?
  hospitalizations   String?
  substanceUse       String?

  // Paso 5: Antecedentes familiares
  familyComposition  String?
  familyRelations    String?
  familyPsychHistory String?
  familyEvents       String?

  // Paso 6: Historia biográfica
  childhoodHistory    String?
  schoolHistory       String?
  workHistory         String?
  relationshipHistory String?
  traumaticEvents     String?

  // Paso 7: Examen del estado mental
  appearance String?
  mood       String?
  affect     String?
  thought    String?
  perception String?
  memory     String?
  attention  String?
  judgment   String?
  insight    String?

  // Paso 8: Impresión diagnóstica
  provisionalDiagnosis  String?
  diagnosticCode        String?
  differentialDiagnosis String?

  // Paso 9: Plan de tratamiento
  therapeuticGoals    String?
  therapeuticApproach String?
  sessionFrequency    String?
  estimatedDuration   String?
  referrals           String?

  completedSteps Int[]    @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
}

model ClinicalHistoryCouple {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Paso 1: Datos de la pareja
  p1Name             String?
  p1Age              String?
  p1Occupation       String?
  p1Education        String?
  p2Name             String?
  p2Age              String?
  p2Occupation       String?
  p2Education        String?
  relationshipStatus String?
  timeTogether       String?
  children           String?

  // Paso 2: Motivo de consulta
  chiefComplaint      String?
  whoInitiated        String?
  problemDuration     String?
  therapyExpectations String?

  // Paso 3: Historia de la relación
  howTheyMet        String?
  courtshipHistory  String?
  significantEvents String?
  crisisPoints      String?

  // Paso 4: Dinámica de conflicto
  mainConflictTopics  String?
  communicationStyle  String?
  negativeCycle       String?
  conflictResolution  String?

  // Paso 5: Intimidad y conexión
  emotionalIntimacy  String?
  sexualLife         String?
  positiveConnection String?

  // Paso 6: Historia familiar y transgeneracional
  p1FamilyModel     String?
  p2FamilyModel     String?
  transgenerational String?

  // Paso 7: Recursos y tentativas previas
  previousTherapy  String?
  solutionAttempts String?
  coupleStrengths  String?

  // Paso 8: Evaluación y factores de riesgo
  p1Commitment     String?
  p2Commitment     String?
  violenceRisk     String?
  infidelityHistory String?
  substanceUse     String?
  individualMH     String?

  // Paso 9: Plan terapéutico
  therapeuticGoals    String?
  therapeuticApproach String?
  sessionModality     String?
  sessionFrequency    String?
  estimatedDuration   String?

  completedSteps Int[]    @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
}

model SessionNote {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessionNumber Int
  sessionDate   DateTime
  noteType      String   @default("LIBRE")
  summary       String?
  topics        String?
  homework      String?
  observations  String?
  nextPlan      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

model AudioTranscriptionJob {
  id                 String   @id @default(cuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId             String
  assemblyAiId       String
  status             String   @default("processing")
  consentConfirmedAt DateTime
  errorMessage       String?
  createdAt          DateTime @default(now())

  @@index([clientId])
  @@index([userId])
}

model Profile {
  id            String    @id @default(cuid())
  userId        String
  slug          String    @unique
  title         String
  bio           String?
  profession    String
  phone         String?
  template      Template  @default(MINIMALIST)
  avatar        String?
  coverImage    String?
  videoUrl      String?
  customization Json?
  socialLinks   Json      @default("{}")
  availability  Json      @default("{}")
  specialty              String?
  yearsExperience        Int?
  country                String?
  city                   String?
  published              Boolean   @default(false)

  // Campos para salud mental / psicólogos
  therapeuticApproaches  String[]  @default([])
  problematics           String[]  @default([])
  populations            String[]  @default([])
  modality               String?
  pricePerSession        Decimal?
  sessionCurrency        String?   @default("MXN")
  sessionDurationMinutes Int?      @default(50)
  cedula                 String?
  university             String?
  degree                 String?
  languages              String[]  @default([])
  acceptsInvoice         Boolean?  @default(false)
  workingStyle           String?
  lastCrisisAssignedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services          Service[]
  offerings Offering[]
  bookings          Booking[]
  availabilitySlots AvailabilitySlot[]
  scheduleBlocks    ScheduleBlock[]
  recurringScheduleBlocks RecurringScheduleBlock[]
  bookingSettings   BookingSettings?
  reviews           Review[]

  @@index([userId])
}

enum Template {
  MINIMALIST
  BOLD
  ELEGANT
  CREATIVE
  CARBONO
}

model Service {
  id              String   @id @default(uuid())
  profileId       String
  name            String
  description     String?
  image           String?
  imagePosition   String?  @default("50% 50%")
  images          String[] @default([])
  price           Decimal
  currency        String   @default("EUR")
  durationMinutes  Int
  sessionModality  String?
  isActive         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile               Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookings              Booking[]
  serviceAvailabilities ServiceAvailability[]

  @@index([profileId])
  @@index([isActive])
}

model Booking {
  id                 String        @id @default(uuid())
  profileId          String
  serviceId          String
  professionalId     String
  clientName         String
  clientEmail        String
  clientPhone        String        // "+34612345678"
  clientNotes        String?
  date               DateTime
  startTime          String        // "09:00"
  endTime            String        // "10:00"
  status             BookingStatus @default(PENDING)
  whatsappNotified   Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cancelledAt        DateTime?
  cancelledBy        String?       // "client" | "professional"
  cancellationReason String?

  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional  User           @relation("ProfessionalBookings", fields: [professionalId], references: [id])
  notifications Notification[]
  reviewToken   ReviewToken?
  review        Review?

  @@index([profileId])
  @@index([professionalId])
  @@index([serviceId])
  @@index([status])
  @@index([date])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Notification {
  id        String             @id @default(uuid())
  bookingId String
  type      NotificationType
  recipient String             // "+34612345678"
  message   String
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  error     String?
  messageId String?
  createdAt DateTime           @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([type])
  @@index([status])
}

enum NotificationType {
  NEW_BOOKING
  CONFIRMATION
  REMINDER_24H
  CANCELLATION
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  profileId String
  dayOfWeek Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime String   // "09:00"
  endTime   String   // "17:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, dayOfWeek])
}

// Configuración general de reservas por perfil
model BookingSettings {
  id                 String   @id @default(uuid())
  profileId          String   @unique
  bufferMinutes      Int      @default(0)
  advanceBookingDays Int      @default(60)
  minAdvanceHours    Int      @default(1)
  cancellationHours  Int      @default(24)
  autoConfirm        Boolean  @default(false)
  emailEnabled       Boolean  @default(true)
  timezone           String   @default("America/Mexico_City")
  language           String   @default("es")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// Bloqueos de fechas/horas específicas (vacaciones, ausencias, etc.)
model ScheduleBlock {
  id        String   @id @default(uuid())
  profileId String
  startDate DateTime // fecha de inicio del bloqueo
  endDate   DateTime // fecha de fin (igual a startDate si es 1 día)
  startTime String?  // HH:mm — null significa todo el día
  endTime   String?  // HH:mm — null significa todo el día
  isAllDay  Boolean  @default(true)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, startDate, endDate])
}

// Bloqueos semanales fijos (ej. "todos los martes 13:00-14:00"), sin fecha de fin
model RecurringScheduleBlock {
  id        String   @id @default(uuid())
  profileId String
  dayOfWeek Int      // 0=Domingo, 1=Lunes, ..., 6=Sábado
  startTime String   // "13:00"
  endTime   String   // "14:00"
  reason    String?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, dayOfWeek])
}

// Disponibilidad específica por servicio (sobreescribe la disponibilidad general)
model ServiceAvailability {
  id        String   @id @default(uuid())
  serviceId String
  dayOfWeek Int      // 0=Domingo, 1=Lunes, ..., 6=Sábado
  startTime String   // "09:00"
  endTime   String   // "17:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([serviceId, dayOfWeek])
}

model ReviewToken {
  id        String    @id @default(uuid())
  bookingId String    @unique
  token     String    @unique @default(uuid())
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  profileId  String
  rating     Int
  comment    String?
  clientName String
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())

  booking    Booking  @relation(fields: [bookingId], references: [id])
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, isVisible])
}

model AnnouncementLog {
  id         String   @id @default(uuid())
  subject    String
  audience   String
  sentCount  Int
  failCount  Int
  recipients Json
  sentAt     DateTime @default(now())

  @@index([sentAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([key])
}

model CrisisReferral {
  id           String   @id @default(cuid())
  riskEventId  String   @unique
  profileId    String?
  emailSuccess Boolean
  createdAt    DateTime @default(now())
}

model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  module    String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([module])
}

model Offering {
  id           String         @id @default(uuid())
  profileId    String
  type         OfferingType
  title        String
  description  String?
  coverImage   String?
  priceUSD     Decimal
  priceMXN     Decimal?
  status       OfferingStatus @default(DRAFT)
  // Solo aplica si type = LIVE_WORKSHOP
  scheduledAt  DateTime?
  capacity     Int?
  externalLink String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  modules   Module[]
  purchases Purchase[]

  @@index([profileId])
  @@index([status])
}

enum OfferingType {
  LIVE_WORKSHOP
  RECORDED_COURSE
}

enum OfferingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Module {
  id          String     @id @default(uuid())
  offeringId  String
  order       Int
  title       String
  description String?
  type        ModuleType
  textContent String?    // solo type = TEXT
  fileUrl     String?    // solo type = VIDEO | PDF (Cloudinary)
  createdAt   DateTime   @default(now())

  offering     Offering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  questions    Question[]
  scoringRules ScoringRule[]

  @@index([offeringId])
}

enum ModuleType {
  TEXT
  VIDEO
  PDF
  QUESTIONNAIRE
}

model Question {
  id       String       @id @default(uuid())
  moduleId String
  order    Int
  text     String
  type     QuestionType

  module  Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers Answer[]

  @@index([moduleId])
}

enum QuestionType {
  FREE_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

model QuestionOption {
  id         String @id @default(uuid())
  questionId String
  label      String
  value      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ScoringRule {
  id       String @id @default(uuid())
  moduleId String
  minScore Int
  maxScore Int
  message  String

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Purchase {
  id          String    @id @default(uuid())
  offeringId  String
  buyerName   String
  buyerEmail  String
  buyerPhone  String?
  accessToken String    @unique
  paidAt      DateTime?
  amountPaid  Decimal?
  currency    String
  providerRef String    @unique
  createdAt   DateTime  @default(now())

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  answers  Answer[]

  @@index([offeringId])
  @@index([accessToken])
}

// Guarda los datos del comprador entre el momento en que se crea una orden de PayPal
// (antes de que el comprador pague) y el momento en que se confirma el pago. PayPal no
// soporta metadata libre como Stripe -- el custom_id de una orden tiene un limite de 127
// caracteres, insuficiente para nombre+correo+telefono -- asi que se guarda aqui y se
// referencia por id en el custom_id. Se borra en cuanto se lee (ver purchaseService.ts).
// Stripe no necesita esto: su metadata permite pasar los datos del comprador directo.
//
// Limite conocido y aceptado por ahora (encontrado en la revision de Fase 3, Task 1): si
// un invitado arranca un checkout de PayPal y nunca lo completa (cierra la pestana, la
// aprobacion de PayPal expira), la fila queda huerfana sin fecha de expiracion ni limpieza
// automatica -- contiene PII (buyerName/buyerEmail/buyerPhone) de alguien que nunca pago.
// No bloquea esta fase (sin trafico real todavia), pero si este checkout se abusa o el
// volumen crece, hay que agregar un campo de expiracion + un job de limpieza.
model PendingOfferingCheckout {
  id         String   @id @default(uuid())
  offeringId String
  buyerName  String
  buyerEmail String
  buyerPhone String?
  currency   String
  createdAt  DateTime @default(now())
}

model Answer {
  id             String   @id @default(uuid())
  purchaseId     String
  questionId     String
  valueText      String?
  valueOptionIds String[] @default([])
  createdAt      DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([questionId])
}

model Category {
  id       String            @id @default(cuid())
  name     String
  slug     String            @unique
  audience CategoryAudience
  active   Boolean           @default(true)
  order    Int               @default(0)
  articles Article[]

  @@index([audience])
}

enum CategoryAudience {
  PACIENTES
  TERAPEUTAS
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  categoryId  String
  coverImage  String?
  featured    Boolean       @default(false)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category Category       @relation(fields: [categoryId], references: [id])
  blocks   ArticleBlock[]

  @@index([categoryId])
  @@index([status])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model ArticleBlock {
  id          String           @id @default(cuid())
  articleId   String
  order       Int
  type        ArticleBlockType
  text        String?
  imageUrl    String?
  imageAlt    String?
  buttonLabel String?
  buttonUrl   String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

enum ArticleBlockType {
  TEXT
  IMAGE
  BUTTON
}
